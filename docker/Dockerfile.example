# Build a deployable image around your agent code.
# Replace python:3.12-slim with your preferred base if needed.
FROM python:3.12-slim

WORKDIR /app

# Install the standalone (pulls engine + UI as transitive deps).
RUN pip install --no-cache-dir idun-agent-engine

# Copy your agent code and config.
# The standalone expects: IDUN_CONFIG_PATH=/app/agent/config.yaml
COPY agent /app/agent
ENV IDUN_CONFIG_PATH=/app/agent/config.yaml

# Add any extra Python deps your agent needs:
# RUN pip install --no-cache-dir langchain-openai langchain-google-genai

# Override defaults via env vars at deploy time:
#   IDUN_ADMIN_AUTH_MODE=password
#   IDUN_ADMIN_PASSWORD_HASH=...        (use: idun-standalone hash-password)
#   IDUN_SESSION_SECRET=...              (use: openssl rand -hex 32)
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/idun
#   OPENAI_API_KEY=...                   (whatever your agent needs)

EXPOSE 8000
CMD ["idun", "serve", "--host", "0.0.0.0", "--port", "8000"]
