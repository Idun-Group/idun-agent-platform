server:
  api:
    port: {{ port | default(8000) }}

agent:
  type: "LANGGRAPH"
  config:
    name: "e2e-lg-chat"
    graph_definition: "{{ agent_module_path }}:graph"
    {%- if checkpointer_db %}
    checkpointer:
      type: "sqlite"
      db_url: "sqlite:///{{ checkpointer_db }}"
    {%- else %}
    checkpointer:
      type: "memory"
    {%- endif %}
    {%- if system_prompt %}
    prompts:
      system: |
        {{ system_prompt | indent(8) }}
    {%- endif %}
